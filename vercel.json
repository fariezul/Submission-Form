{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "//": "A rewrite serves alumni.html at the tidy address /alumni without changing what the address bar says. A redirect would bounce visitors to /alumni.html, which is not the address printed on the poster.",
  "rewrites": [
    {
      "source": "/alumni",
      "destination": "/alumni.html"
    }
  ],

  "redirects": [
    {
      "source": "/line",
      "destination": "/production-coordination/activity-5.html",
      "permanent": false
    },
    {
      "source": "/line/a",
      "destination": "/production-coordination/line5/station-a.html",
      "permanent": false
    },
    {
      "source": "/line/b",
      "destination": "/production-coordination/line5/station-b.html",
      "permanent": false
    },
    {
      "source": "/line/c",
      "destination": "/production-coordination/line5/station-c.html",
      "permanent": false
    },
    {
      "source": "/line/d",
      "destination": "/production-coordination/line5/station-d.html",
      "permanent": false
    }
  ]
}
